# Kassenstürzle – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an:
#
#     cp .env.example .env
#
# Niemals .env in Git einchecken (ist in .gitignore). Die .env enthält den
# Datenbankschlüssel - sie gehört zusammen mit ./data in die Sicherung.
#
# ACHTUNG (Docker): env_file überschreibt die Vorgaben aus dem Dockerfile. Ein
# Wert, der hier steht, gilt also immer - auch wenn das Image etwas anderes
# vorgibt.

# ── Datenbank ─────────────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbank. Im Container nicht ändern: /app/data ist das
# gemountete Verzeichnis ./data. Backups, Belege und die Schlüsseldateien
# liegen im selben Verzeichnis.
DATABASE_PATH=/app/data/kassenstuerzle.db

# SQLCipher-Verschlüsselung der Datenbank. PFLICHT: ohne Schlüssel verweigert die
# App den Start (siehe ALLOW_UNENCRYPTED unten).
# Erzeugen, z. B.:   openssl rand -hex 32
# ACHTUNG: Nach dem ersten Start niemals ändern oder verlieren - ohne den
# Schlüssel sind Datenbank UND Backups unlesbar!
# Beim ersten Start mit gesetztem Schlüssel wird eine bestehende unverschlüsselte
# Datenbank automatisch migriert (Sicherungskopie vorher).
DB_ENCRYPTION_KEY=

# Bewusster Betrieb OHNE Verschlüsselung. Nur mit 1 setzen, wenn die Daten
# wirklich im Klartext liegen sollen; dann DB_ENCRYPTION_KEY leer lassen.
# ALLOW_UNENCRYPTED=1

# ── Anmeldung und Sitzung ─────────────────────────────────────────────────────
# Einmalpasswort für das erste Admin-Konto (nur beim allerersten Start). Beim
# ersten Login erzwingt die App einen Passwortwechsel.
# Nicht gesetzt: es wird ein zufälliges Passwort erzeugt und ins Log geschrieben
# (docker compose logs). Das Log ist dann vertraulich zu behandeln.
ADMIN_PASSWORD=

# Sitzungsdauer in Stunden (danach automatische Abmeldung)
SESSION_LIFETIME_HOURS=12

# Flask-Schlüssel für Sitzungen. Wird automatisch erzeugt und in
# data/.secret_key abgelegt, wenn nichts gesetzt ist - in der Regel nicht nötig.
# SECRET_KEY=

# HTTPS=1: Sitzungscookie bekommt das Secure-Flag. Richtig, sobald ein
#          TLS-Reverse-Proxy (Caddy, nginx) vor der App steht.
# HTTPS=0: nur für bewussten Betrieb ohne TLS, z. B. im reinen Heimnetz.
#          Passwort und Cookie gehen dann unverschlüsselt über das Netz.
# Achtung: Mit HTTPS=1 funktioniert die Anmeldung über reines http NICHT.
HTTPS=1

# ── Benachrichtigungen ────────────────────────────────────────────────────────
# Web-Push (Erinnerungen an offene Abrechnungen): Das VAPID-Schlüsselpaar wird
# beim ersten Start automatisch erzeugt und in data/.vapid_private_key.pem
# gespeichert. Hier muss nichts gesetzt werden.
# Optional: Kontaktadresse für den VAPID-Header
# VAPID_SUBJECT=mailto:deine-adresse@example.com
# Stunde (0-23), zu der der tägliche Erinnerungs-Check läuft
# PUSH_REMINDER_HOUR=9

# ── Belege ────────────────────────────────────────────────────────────────────
# Obergrenze für das gesamte Beleg-Verzeichnis in MB. Danach werden neue
# Uploads abgelehnt, damit niemand den Datenträger füllen kann.
# RECEIPTS_MAX_TOTAL_MB=500

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# Bind-Adresse im Container. Nach außen bestimmt die Port-Zeile in der
# docker-compose.yml, wer die App erreicht (Standard: nur 127.0.0.1).
GUNICORN_BIND=0.0.0.0:5000

# Worker-Prozesse. WICHTIG: Bei mehr als 1 Worker müssen Rate-Limit und
# Erinnerungs-Scheduler auf ein gemeinsames Backend umgestellt werden
# (siehe gunicorn.conf.py).
GUNICORN_WORKERS=1

# Threads pro Worker
GUNICORN_THREADS=4

# Zeitlimit pro Anfrage in Sekunden (OCR und PDF-Import können dauern)
GUNICORN_TIMEOUT=120

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warning | error | critical
LOG_LEVEL=info

# Optional: Logdatei mit Rotation (5 MB, 3 Sicherungen). Leer lassen für reine
# stdout-Ausgabe (empfohlen für Docker).
# LOG_FILE=/app/logs/kassenstuerzle.log

# ── Reverse-Proxy ─────────────────────────────────────────────────────────────
# IPs, denen X-Forwarded-* vertraut wird (kommagetrennt). Beim Proxy auf
# demselben Host reicht 127.0.0.1.
FORWARDED_ALLOW_IPS=127.0.0.1
