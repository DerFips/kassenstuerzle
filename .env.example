# Kassenstürzle – Umgebungsvariablen
# Kopiere diese Datei nach .env und passe die Werte an.
# Niemals .env in Git einchecken (ist in .gitignore).

# ── Datenbank ─────────────────────────────────────────────────────────────────
# Absoluter Pfad zur SQLite-Datenbank
DATABASE_PATH=data/kassenstuerzle.db

# SQLCipher-Verschlüsselung der Datenbank (optional, aber empfohlen)
# Setze einen langen, zufälligen Schlüssel (min. 32 Zeichen).
# ACHTUNG: Nach einmaligem Setzen niemals mehr ändern – sonst ist die DB unlesbar!
# Beim ersten Start mit gesetztem Key wird eine bestehende unverschlüsselte DB
# automatisch migriert (Backup wird vorher angelegt).
# Leer lassen = keine Verschlüsselung (Standard, rückwärtskompatibel)
# DB_ENCRYPTION_KEY=ersetze-mich-mit-einem-sehr-langen-zufaelligen-schluessel

# ── Sicherheit ────────────────────────────────────────────────────────────────
# Geheimer Schlüssel für Flask-Sessions (min. 32 zufällige Bytes, Base64 oder Hex)
# Wird automatisch generiert wenn nicht gesetzt (data/.secret_key)
# SECRET_KEY=ersetze-mich-mit-einem-langen-zufaelligen-string

# Initiales Admin-Passwort beim ersten Start (wird gehasht gespeichert)
# Wird nicht gesetzt: zufälliges Passwort generiert + im Log ausgegeben
# ADMIN_PASSWORD=sicher-langes-passwort

# VAPID Public Key für Web-Push-Benachrichtigungen (optional)
# VAPID_PUBLIC_KEY=

# Session-Lifetime in Stunden (nach Ablauf: automatischer Logout)
SESSION_LIFETIME_HOURS=12

# HTTPS=1 setzen wenn die App hinter einem TLS-Proxy (nginx/caddy) läuft
# Aktiviert SESSION_COOKIE_SECURE
HTTPS=0

# ── Gunicorn ──────────────────────────────────────────────────────────────────
# Bind-Adresse und Port
GUNICORN_BIND=0.0.0.0:5000

# Anzahl Worker-Prozesse
# WICHTIG: Bei > 1 Worker Flask-Limiter auf Redis-Backend umstellen!
# Siehe gunicorn.conf.py – Kommentar "Multi-Worker"
GUNICORN_WORKERS=1

# Threads pro Worker (async Requests)
GUNICORN_THREADS=4

# Timeout in Sekunden (OCR/PDF-Import kann länger dauern)
GUNICORN_TIMEOUT=120

# ── Logging ───────────────────────────────────────────────────────────────────
# Log-Level: debug | info | warning | error | critical
LOG_LEVEL=info

# Optionaler Pfad für Log-Datei mit automatischer Rotation (5 MB, 3 Backups)
# Leer lassen für reine stdout-Ausgabe (empfohlen für Docker)
# LOG_FILE=/app/logs/kassenstuerzle.log

# ── Reverse-Proxy ─────────────────────────────────────────────────────────────
# IPs die X-Forwarded-For setzen dürfen (Komma-separiert)
FORWARDED_ALLOW_IPS=127.0.0.1
